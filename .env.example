# ANISAS Enterprise — example environment file
#
# Copy this file to `.env` and fill in the keys you have.
# `.env` is git-ignored and must never be committed.
#
#   copy .env.example .env      (Windows / cmd)
#   cp .env.example .env        (macOS / Linux)
#
# Every API key is optional: a missing key only disables that one data source.

# ── Runtime ──────────────────────────────────────────────────────────────────
PORT=9000
DEBUG=false
NODE_ENV=development

# ── Security ─────────────────────────────────────────────────────────────────
# Used by the Node reference API. Replace with a long random string.
JWT_SECRET=change-me-in-production

# ── Internal services (Node reference stack only) ────────────────────────────
DATABASE_URL="postgresql://anisas:anisas_dev_password@localhost:5432/anisas_db?schema=public"
REDIS_URL="redis://localhost:6379"
AI_SERVICE_URL="http://localhost:9000"
FRONTEND_URL="http://localhost:3000"

# ── Threat intelligence providers (optional) ─────────────────────────────────
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
CENSYS_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
OTX_API_KEY=
ABUSEIPDB_API_KEY=
IPINFO_TOKEN=
GREYNOISE_API_KEY=
SECURITYTRAILS_API_KEY=
BINARYEDGE_API_KEY=
FOFA_API_KEY=
ZOOMEYE_API_KEY=

# ── AI reporting (optional) ──────────────────────────────────────────────────
GROQ_API_KEY=
OPENAI_API_KEY=

# ── Scan toggles ─────────────────────────────────────────────────────────────
ENABLE_SHODAN_SCANS=true
ENABLE_OTX_SCANS=true
ENABLE_VIRUSTOTAL_SCANS=true
ENABLE_CENSYS_SCANS=false
ENABLE_GROQ_AI=true

# ── Per-scan key overrides (leave empty to reuse the keys above) ─────────────
SHODAN_API_KEY_FOR_SCANS=
OTX_API_KEY_FOR_SCANS=
VIRUSTOTAL_API_KEY_FOR_SCANS=
CENSYS_API_KEY_FOR_SCANS=
CENSYS_API_ID_FOR_SCANS=
CENSYS_API_SECRET_FOR_SCANS=
