{
  "version": 2,
  "builds": [
    { "src": "ai-service/static/index.html", "use": "static" /*, "functions": "api/functions"**/ }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "ai-service/static/index.html" }
  ],
  "headers": [
    { "src": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ],
  "outputDirectory": "ai-service/static",
  "framework": "none"
}

# NOTE:
#   This config serves the static HTML for any route.
#   The FastAPI backend (main.py on port 9000) must remain reachable.
#   If you want API calls (e.g. /api/v1/topology/force) to work on Vercel,
#   you have two options:
#     1. Keep the backend on a separate host and set AI_SERVICE_URL env var
#        in Vercel project settings.
#     2. Use Vercel Functions (Node) as a proxy, or Deploy the Python app
#        on a platform that supports it (Render, Railway, Fly.io, etc.)
#   The frontend JavaScript expects the backend at the URL set in
#   src/js/env.js or via meta tag; update that if moving backend.